# Copy to .env.local (git-ignored).

# AI interpretation layer
ANTHROPIC_API_KEY=
# RESIDUAL_LLM_MODEL=claude-sonnet-5

# Bitget Demo Trading (optional). When all three are set, live-mode trades are
# placed as Demo Trading orders (header paptrading: 1) instead of local paper fills.
BITGET_DEMO_API_KEY=
BITGET_DEMO_API_SECRET=
BITGET_DEMO_API_PASSPHRASE=
# BITGET_DEMO_PRODUCT_TYPE=SUSDT-FUTURES
# BITGET_DEMO_MARGIN_COIN=SUSDT

# Only if api.bitget.com fails because of a local resolver fault and Bitget access is
# permitted where you are. Never use this to get around regional restrictions.
# RESIDUAL_DOH_FALLBACK=1

# SEC_USER_AGENT="Your Name your@email.com"
